<!--
  Generates ../../sso-vectors.json from the C# password-manager-access library:
    dotnet run -c Release -p:PasswordManagerAccess=<checkout> > ../../sso-vectors.json
  The assembly borrows the name of the library's test project to see its internals.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>PasswordManagerAccess.Test</AssemblyName>
    <RootNamespace>SsoVectors</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(PasswordManagerAccess)/src/PasswordManagerAccess.csproj" />
    <PackageReference Include="Ristretto" Version="1.0.1" />
  </ItemGroup>
</Project>
